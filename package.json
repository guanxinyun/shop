{
  "name": "atelier-shop-rpg",
  "version": "1.0.0",
  "description": "工坊物语：杂货铺掌柜的记账本 - 日式轻西幻生活流模拟经营RPG",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "cap:sync": "cap sync",
    "cap:build:android": "cap build android",
    "cap:open:android": "cap open android"
  },
  "keywords": [
    "game",
    "rpg",
    "atelier",
    "web-game",
    "electron",
    "capacitor"
  ],
  "author": "guanxinyun",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^5.6.0",
    "@capacitor/cli": "^5.6.0",
    "@capacitor/core": "^5.6.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.guanxinyun.ateliershop",
    "productName": "工坊物语",
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
